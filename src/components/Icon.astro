---
/**
 * 图标组件 —— 内联 SVG，零依赖、可继承文字颜色。
 * 图标源自 Lucide (https://lucide.dev)，ISC 许可。
 * 需要新图标时：从 https://unpkg.com/lucide-static@latest/icons/<name>.svg 取内部路径，加进下面的表即可。
 */
interface Props {
  name: keyof typeof paths;
  size?: number | string;
  strokeWidth?: number;
  class?: string;
  /** 无障碍：有 title 时作为可读文本，否则视为纯装饰 */
  title?: string;
}

const paths = {
  // ===== 分社标志 =====
  // 硬算社：Σ，数学求和符号
