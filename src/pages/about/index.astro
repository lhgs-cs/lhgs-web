---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="关于我们 | 联合公社"
  description="了解联合公社的性质、组成分社，以及本网站的建设与维护情况、联系方式。"
  canonical="https://lianhegongshe.cn/about/"
  loadParticles={true}
>
  <Nav mode="back" backHref="/" backLabel="返回首页" active="about" />

  <main class="container">
    <div class="page-header">
      <h1>关于我们</h1>
    </div>

    <div class="info-section">
      <div class="info-label">性质</div>
      <div class="info-value">学生团体组织</div>
    </div>

    <div class="info-section">
      <div class="info-label">说明</div>
      <div class="info-value">联合公社是一个大家庭，旗下有硬算社、朗诵社、计算机科学社等，每个分社各有特色，共同组成了我们。</div>
    </div>

    <div class="info-section">
      <div class="info-label">网站构建</div>
      <div class="info-value">
        本网站为联合公社（Union Commune）官方网站，用于展示公社简介、社训、组成分社、社员风采等信息，并为各分社独立页面提供入口，社员也可以在其上放置自己的个人主页。<br /><br />
        技术栈：纯静态 HTML/CSS/JS，部署于阿里云 ESA Pages，版本控制：Git + GitHub。<br /><br />
        本网站由联合公社技术小组维护，主要搭建与维护者：光明与尘埃（GitHub: @gmyca）、C0（GitHub: @imxilin）。欢迎通过 Pull Request 或 Issue 提出建议。<br /><br />
        📂 GitHub 仓库：<a href="https://github.com/lhgs-cs/lhgs-web" target="_blank" rel="noopener noreferrer">github.com/lhgs-cs/lhgs-web</a>
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-card-icon">📧</div>
      <div class="contact-card-label">联系邮箱</div>
      <a class="contact-card-email" href="mailto:927336167@qq.com">927336167@qq.com</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  /* ===== 页面标题 ===== */
  .page-header {
      text-align: center;
      margin: 2rem 0 3rem;
      position: relative;
  }
  .page-header h1 {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent-blue) 50%, var(--primary-dark) 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 2px;
      animation: heroGradient 4s ease infinite;
  }

  /* 装饰浮动圆 */
  .page-header::before,
  .page-header::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      opacity: 0.06;
      pointer-events: none;
  }
  .page-header::before {
      width: 160px;
      height: 160px;
      background: var(--primary);
      top: -30px;
      left: -40px;
      animation: float 6s ease-in-out infinite;
  }
  .page-header::after {
      width: 100px;
      height: 100px;
      background: var(--accent-orange);
      bottom: -10px;
      right: -30px;
      animation: float 8s ease-in-out infinite reverse;
  }

  /* ===== 信息卡片 ===== */
  .info-section {
      margin: 2rem 0;
  }
  .info-section:first-of-type {
      margin-top: 0;
  }
  .info-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.4rem;
      padding-left: 0.2rem;
  }
  .info-value {
      font-size: 1.05rem;
      color: var(--text-secondary);
      line-height: 2;
      padding: 1rem 1.2rem;
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
  }
  .info-value a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s var(--ease);
  }
  .info-value a:hover {
      color: var(--primary-dark);
      text-decoration: underline;
  }

  /* ===== 联系邮箱卡片 ===== */
  .contact-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      padding: 2rem 1.5rem;
      text-align: center;
      border: 1px solid var(--border);
      margin-top: 2.5rem;
  }
  /* 金色短线：与首页社训块呼应 */
  .contact-card::before {
      content: '';
      display: block;
      width: 46px;
      height: 2px;
      margin: 0 auto 1rem;
      border-radius: 2px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .contact-card-icon {
      font-size: 2rem;
      margin-bottom: 0.8rem;
  }
  .contact-card-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
  }
  .contact-card-email {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--primary);
      text-decoration: none;
      transition: color 0.2s var(--ease);
  }
  .contact-card-email:hover {
      color: var(--primary-dark);
      text-decoration: underline;
  }

  /* ===== 响应式 ===== */
  @media (max-width: 768px) {
      .page-header {
          margin: 1.5rem 0 2rem;
      }
      .page-header h1 {
          font-size: 1.8rem;
          letter-spacing: 1px;
      }
      .info-value {
          font-size: 0.95rem;
          padding: 0.9rem 1rem;
          line-height: 1.8;
      }
      .contact-card {
          padding: 1.5rem 1rem;
          border-radius: var(--radius-lg);
      }
      .contact-card-email {
          font-size: 1rem;
      }
      .page-header::before {
          width: 100px;
          height: 100px;
      }
      .page-header::after {
          width: 60px;
          height: 60px;
      }
  }

  @media (max-width: 480px) {
      .page-header {
          margin: 1rem 0 1.5rem;
      }
      .page-header h1 {
          font-size: 1.5rem;
          letter-spacing: 0.5px;
      }
      .info-value {
          font-size: 0.88rem;
      }
      .info-label {
          font-size: 0.78rem;
      }
  }
</style>
