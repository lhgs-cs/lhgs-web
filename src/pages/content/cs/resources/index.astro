---
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import { getCollection } from 'astro:content';

// 排序：置顶优先，其余按发布时间倒序
const items = (await getCollection('resources', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  });

const tags = [...new Set(items.flatMap((r) => r.data.tags))].sort();
---
<Base
  title="推荐学习资源 | 计科资源中心"
  description="社员写下的学习资源推荐：为什么值得看、适合谁、怎么用。"
  canonical="https://lianhegongshe.cn/content/cs/resources/"
>
  <Nav mode="back" backHref="/content/cs/" backLabel="返回资源中心" active="content" />

  <main class="container">
    <div class="page-header">
      <h1>推荐学习资源</h1>
      <p>不是链接导航，是社员写下的推荐理由</p>
    </div>

    {items.length === 0 ? (
      <p class="empty-tip">还没有资源推荐。</p>
    ) : (
      <>
        <div class="tag-filter" id="tagFilter">
          <button class="tag-chip is-active" data-tag="all" type="button">全部</button>
          {tags.map((tag) => (
            <button class="tag-chip" data-tag={tag} type="button">{tag}</button>
          ))}
        </div>

        <ul class="item-list" id="itemList">
          {items.map((r) => (
            <li class="item" data-tags={r.data.tags.join(',')}>
              {r.data.pinned && <span class="pin-badge">置顶</span>}
              <a class="item-title" href={`/content/cs/resources/${r.id}/`}>{r.data.title}</a>
              <p class="item-desc">{r.data.description}</p>
              <div class="item-meta">
                <time datetime={r.data.publishDate.toISOString()}>
                  {r.data.publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                </time>
                {r.data.author && <span class="item-author">{r.data.author}</span>}
                {r.data.tags.map((tag) => <span class="item-tag">{tag}</span>)}
                {r.data.link && (
                  <a class="item-link" href={r.data.link} target="_blank" rel="noopener noreferrer">外部链接 ↗</a>
                )}
              </div>
            </li>
          ))}
        </ul>

        <noscript>
          <p class="noscript-tip">标签筛选需要启用 JavaScript，上面已按置顶与时间列出全部条目。</p>
        </noscript>
      </>
    )}
  </main>

  <Footer />
</Base>

<script>
  const filter = document.getElementById('tagFilter');
  const list = document.getElementById('itemList');
  if (filter && list) {
    filter.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.tag-chip') as HTMLElement | null;
      if (!btn) return;
      const tag = btn.dataset.tag || 'all';
      filter.querySelectorAll('.tag-chip').forEach((b) => b.classList.toggle('is-active', b === btn));
      list.querySelectorAll('.item').forEach((el) => {
        const item = el as HTMLElement;
        const itemTags = (item.dataset.tags || '').split(',').filter(Boolean);
        item.hidden = tag !== 'all' && !itemTags.includes(tag);
      });
    });
  }
</script>

<style>
  .page-header {
      text-align: center;
      margin: 2rem 0 2.5rem;
  }
  .page-header h1 {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent-blue) 50%, var(--primary-dark) 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 2px;
      animation: heroGradient 4s ease infinite;
  }
  .page-header p {
      color: var(--text-muted);
      margin-top: 0.5rem;
      font-size: 0.95rem;
  }

  .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: 1.5rem;
  }
  .tag-chip {
      font-family: inherit;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text-secondary);
      cursor: pointer;
      transition: background 0.2s var(--ease), color 0.2s var(--ease),
                  border-color 0.2s var(--ease);
  }
  .tag-chip:hover { border-color: var(--primary); color: var(--primary); }
  .tag-chip.is-active { background: var(--primary); border-color: var(--primary); color: white; }

  .item-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
  }
  .item {
      position: relative;
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      padding: 1.2rem 1.4rem;
      transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
                  border-color 0.3s var(--ease);
  }
  .item:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--primary);
  }
  .item[hidden] { display: none; }

  .pin-badge {
      position: absolute;
      top: 0.9rem;
      right: 0.9rem;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      background: rgba(176, 141, 79, .15);
      color: var(--gold-text);
      letter-spacing: 0.05em;
  }
  .item-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      transition: color 0.2s var(--ease);
      padding-right: 3rem;
  }
  .item-title:hover { color: var(--primary); }
  .item-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-top: 0.3rem;
  }
  .item-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.7rem;
      font-size: 0.75rem;
      color: var(--text-muted);
  }
  .item-author { font-weight: 600; color: var(--text-secondary); }
  .item-tag {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.12rem 0.5rem;
      border-radius: 6px;
      background: var(--primary-light);
      color: var(--primary-dark);
  }
  .item-link {
      font-size: 0.72rem;
      color: var(--primary);
      text-decoration: none;
      border-bottom: 1px solid var(--gold-line);
  }
  .empty-tip, .noscript-tip {
      font-size: 0.88rem;
      color: var(--text-muted);
      text-align: center;
      padding: 1.5rem 0;
  }

  @media (max-width: 768px) {
      .page-header h1 { font-size: 2rem; }
      .item { padding: 1rem 1.1rem; }
  }
  @media (max-width: 480px) {
      .page-header h1 { font-size: 1.6rem; }
  }
</style>
