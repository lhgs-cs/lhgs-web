---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import MemberCard from '../../../components/MemberCard.astro';
import { membersOf } from '../../../data/members';

const subgroupId = 'cs';
const list = membersOf(subgroupId);
---
<Base
  title="计算机科学社 | 联合公社"
  description="计算机科学社（CS社）是联合公社核心分社之一，负责技术开发与维护，开展编程、算法、系统设计等技术活动。"
  canonical="https://lianhegongshe.cn/subgroups/cs/"
  loadParticles={false}
>
  <Nav mode="back" backHref="/" backLabel="返回首页" active="subgroups" />

  <main class="container">
    <div class="page-hero">
      <div class="page-hero-icon">💻</div>
      <h1>计算机科学社</h1>
      <p class="page-hero-sub">Computer Science Club</p>
    </div>

    <div class="info-section reveal">
      <h2 class="info-section-title">简介</h2>
      <div class="info-card">
        CS社，简称计科社，是联合公社的核心分社之一。负责技术开发与维护，培养计算机科学兴趣，组织开展编程、算法、系统设计等技术活动。
      </div>
    </div>

    <div class="info-section reveal">
      <h2 class="info-section-title">社团特色</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">🖥️</div>
          <div class="feature-name">编程实践</div>
          <div class="feature-desc">从入门到进阶的编程训练</div>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <div class="feature-name">网站开发</div>
          <div class="feature-desc">维护与搭建联合公社官网</div>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔧</div>
          <div class="feature-name">算法挑战</div>
          <div class="feature-desc">算法竞赛与逻辑思维训练</div>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🤝</div>
          <div class="feature-name">项目协作</div>
          <div class="feature-desc">Git协作与团队项目开发</div>
        </div>
      </div>
    </div>

    <!-- 资源中心入口 -->
    <div class="info-section reveal">
      <div class="info-card resource-entry">
        <div class="resource-entry-title">计科资源中心</div>
        <p class="resource-entry-desc">学习资源、社内教程与代码仓库</p>
        <a class="card-btn" href="/content/cs/"><span>进入资源中心 →</span></a>
      </div>
    </div>

    <div class="info-section reveal">
      <h2 class="info-section-title">社员</h2>
      <div class="member-list">
        {list.map((m) => <MemberCard member={m} showRoleFor={subgroupId} />)}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .container {
      --accent: #2c6b8f;
      --accent-light: #e7eef3;
      --accent-gradient: linear-gradient(135deg, #2c6b8f, #1d5578);
  }

  .page-hero {
      text-align: center;
      margin: 2rem 0 3rem;
      position: relative;
  }
  .page-hero-icon {
      width: 80px; height: 80px;
      border-radius: var(--radius-lg);
      background: var(--accent-gradient);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 2.5rem;
      margin-bottom: 1.2rem;
      box-shadow: 0 8px 24px rgba(44,107,143,0.2);
      animation: iconFloat 3s ease-in-out infinite;
  }
  @keyframes iconFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
  }
  .page-hero h1 {
      font-size: 2.5rem; font-weight: 800;
      color: var(--text); letter-spacing: 2px;
  }
  .page-hero-sub {
      color: var(--text-muted); margin-top: 0.5rem; font-size: 0.95rem;
  }

  .page-hero::before,
  .page-hero::after {
      content: ''; position: absolute; border-radius: 50%; opacity: 0.06; pointer-events: none;
  }
  .page-hero::before {
      width: 180px; height: 180px; background: var(--accent);
      top: -40px; left: -50px; animation: float 6s ease-in-out infinite;
  }
  .page-hero::after {
      width: 120px; height: 120px; background: var(--primary-dark);
      bottom: -20px; right: -30px; animation: float 8s ease-in-out infinite reverse;
  }

  .info-section { margin: 2.5rem 0; }
  .info-section-title {
      font-size: 1.3rem; font-weight: 700; color: var(--text);
      margin-bottom: 1rem;
      display: flex; align-items: center; gap: 0.5rem;
  }
  .info-section-title::before {
      content: ''; width: 4px; height: 24px; border-radius: 4px;
      background: var(--accent-gradient);
  }

  .info-card {
      background: var(--card-bg); border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-sm); border: 1px solid var(--border);
      line-height: 1.8; color: var(--text-secondary);
      transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .info-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
  }

  /* 资源中心入口 */
  .resource-entry { text-align: center; }
  .resource-entry-title {
      font-size: 1.15rem; font-weight: 700; color: var(--text); margin-bottom: .35rem;
  }
  .resource-entry-desc {
      font-size: .85rem; color: var(--text-muted); margin-bottom: 1rem;
  }
  .card-btn {
      display: inline-block;
      background: none;
      border: 1.5px solid var(--border);
      padding: 0.5rem 1.2rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background 0.32s var(--ease), color 0.32s var(--ease),
                  border-color 0.32s var(--ease), transform 0.32s var(--ease),
                  box-shadow 0.32s var(--ease);
  }
  .card-btn:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
      transform: translateY(-1.5px);
      box-shadow: 0 6px 16px -6px rgba(29, 85, 120, .55);
  }

  .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
  }
  .feature-card {
      background: var(--card-bg); border-radius: var(--radius-lg);
      padding: 1.3rem;
      box-shadow: var(--shadow-sm); border: 1px solid var(--border);
      text-align: center;
      transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .feature-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
  }
  .feature-icon {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
  }
  .feature-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
  }
  .feature-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
  }

  .member-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .reveal {
      opacity: 0; transform: translateY(25px);
      transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
      .page-hero h1 { font-size: 2rem; }
      .page-hero-icon { width: 64px; height: 64px; font-size: 2rem; }
      .page-hero::before { width: 100px; height: 100px; }
      .page-hero::after { width: 60px; height: 60px; }
  }

  @media (max-width: 480px) {
      .page-hero h1 { font-size: 1.6rem; }
      .page-hero-icon { width: 56px; height: 56px; font-size: 1.6rem; }
      .info-card { padding: 1.2rem; }
      .feature-grid { grid-template-columns: 1fr; }
  }
</style>
